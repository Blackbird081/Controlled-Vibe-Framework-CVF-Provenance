#!/usr/bin/env sh

set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# P4-C1 fail-closed safety check: block before the normal governance hook
# chain runs if the automatic evidence collector left an unresolved safety
# marker. This is a bare file-existence check -- no AI, no Python analysis.
# Only reviewer/closer adjudication may remove the marker.
p4c1_marker=".cvf/runtime/mfrp-p4-shadow-canary/UNRESOLVED_SAFETY_MARKER.json"
if [ -f "$p4c1_marker" ]; then
    echo "BLOCKED: P4-C1 unresolved safety marker present at $p4c1_marker" >&2
    echo "This commit is blocked until reviewer/closer adjudicates and removes the marker." >&2
    exit 1
fi

PYTHONUTF8=1 python governance/compat/run_local_governance_hook_chain.py --hook pre-commit
