    " 'probeSourceLines': source.decode('utf-8').splitlines(),",
    " 'oracleSeparationBasis': 'Independently authored predicate on actual returned matrix fields, ledger membership, and distinct mutations; no worker helper import or execution.',",
    " 'status': 'PASS_STATIC_ONLY' if all(r['passed'] for r in results) else 'FAIL_STATIC_ONLY',",
