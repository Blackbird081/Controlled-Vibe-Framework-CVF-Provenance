    "\"\"\"Local documentary oracle. Does not import worker or upstream code.\"\"\"",
    "import copy",
    "import hashlib",
    "import json",
    "from pathlib import Path",
    "",
    "WORKER = 'docs/reviews/evidence/cvf-ncr-s05-control-fixture-design-worker-2026-10-03.json'",
    "OUT = 'docs/reviews/evidence/cvf-ncr-s05-control-fixture-design-local-review-2026-10-03.json'",
    "d = json.loads(Path(WORKER).read_text(encoding='utf-8'))",
    "results = []",
    "",
    "def invariant(x):",
    "    stages = {r['id']: r for r in x['stageMatrix']}",
    "    roots = {r['id']: r for r in x['rootDispositions']}",
    "    return all([",
    "        x['helperIdentity']['state'] == 'ABSENT',",
    "        x['helperIdentity']['hash'] is None,",
    "        x['helperIdentity']['sourceBytes'] is None,",
    "        not x['helperIdentity']['installedExecutable'],",
    "        'NO_GO' in roots['G3']['disposition'],",
    "        all(not r['performed'] and not r['admittedNow'] for r in x['effectManifest']),",
    "        all(not stages[f'S{i}']['needsListener'] and not stages[f'S{i}']['needsConsent'] for i in range(6)),",
    "        stages['S6']['needsListener'] and stages['S6']['needsConsent'],",
    "        all(r['status'] == 'NOT_EXECUTED_PLANNED' for r in x['plannedCases']),",
    "        x['scec']['requiredDisposition'] == 'STOP_REASSESS_ARCHITECTURE',",
    "        not x['scec']['blockerDelta']['resolved'],",
    "        all(r['status'] == 'UNPROVEN' for r in x['policyEnforcementMap']),",
    "        'editable' in x['sdk']['lockRoot'],",
    "        x['npm']['necessity'].startswith('UNKNOWN'),",
    "        x['releaseMatrix'][1]['blocks'] == 'consent unverified',",
    "        'not a ceiling' in x['arithmetic']['declaredKnownIngressSum']['claim'],",
    "        x['costs'] == {'sessionAndExecution': 'UNKNOWN', 'money': 'UNKNOWN'},",
    "    ])",
    "",
    "def check(name, ok):",
    "    results.append({'id': name, 'passed': bool(ok)})",
    "",
    "check('LP-01-actual-design-is-valid-consolidated-no-go', invariant(d))",
    "check('LP-02-stage-and-effect-coverage', {r['id'] for r in d['stageMatrix']} == {f'S{i}' for i in range(10)} and {r['id'] for r in d['effectManifest']} == {f'E{i}' for i in range(1,10)})",
    "check('LP-03-case-and-fixture-coverage', {r['id'] for r in d['plannedCases']} == {f'DS-{i:02}' for i in range(1,20)} and {r['id'] for r in d['fixtures']} == {'FX-D1','FX-M1','FX-T1','FX-B1','FX-N1','FX-L1'})",
    "check('LP-04-input-identities', all(hashlib.sha256(Path(r['path']).read_bytes()).hexdigest() == r['rawSha256'] for r in d['inputIdentities']))",
    "check('LP-05-conditional-ingress-arithmetic', 262308771+565974704+119527247+194054347 == d['arithmetic']['declaredKnownIngressSum']['bytes'] and 2**31-1141865069 == d['arithmetic']['declaredKnownIngressSum']['headroomToTwoGiB'])",
    "check('LP-06-finite-egress-is-not-proof-on-timeout', 'NOT_PROVEN' in next(r for r in d['fixtures'] if r['id']=='FX-N1')['assertions'])",
    "check('LP-07-retained-snapshot-ledger-join', all(r['sha256'] in Path(d['inputIdentities'][3]['path']).read_text(encoding='utf-8') for r in d['retainedSnapshots']))",
    "mutations = [",
    " ('LP-N01-invent-installed-helper', lambda x: x['helperIdentity'].update(state='INSTALLED', hash='a'*64)),",
    " ('LP-N02-infer-consent-from-hash', lambda x: x['releaseMatrix'][1].update(blocks='consent verified by hash')),",
    " ('LP-N03-working-set-as-commit-proof', lambda x: x['policyEnforcementMap'][2].update(status='PROVEN_WORKING_SET')),",
    " ('LP-N04-editable-root-as-installed-sdk', lambda x: x['sdk'].update(lockRoot='installed SDK')),",
    " ('LP-N05-invent-egress-proof', lambda x: x['policyEnforcementMap'][0].update(status='PROVEN_ZERO_SOCKET_SUCCESS')),",
    " ('LP-N06-listener-blocks-design', lambda x: x['stageMatrix'][0].update(needsListener=True)),",
    " ('LP-N07-history-grants-refresh-effect', lambda x: x['effectManifest'][0].update(admittedNow=True)),",
    " ('LP-N08-runtime-cases-marked-executed', lambda x: x['plannedCases'][0].update(status='PASS_EXECUTED')),",
    " ('LP-N09-silent-scec-reset', lambda x: x['scec'].update(requiredDisposition='READY_WITH_EXECUTABLE_PROOF')),",
    "]",
    "for name, mutate in mutations:",
    "    changed = copy.deepcopy(d)",
    "    mutate(changed)",
    "    check(name, not invariant(changed))",
    "for i in range(6):",
    "    check(f'LP-F{i}-nonvoice-stage-without-listener-consent', not d['stageMatrix'][i]['needsListener'] and not d['stageMatrix'][i]['needsConsent'])",
    "source = Path(__file__).read_bytes()",
    "receipt = {",
